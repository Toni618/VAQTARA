{
  "expo": {
    "name": "وقتارا",
    "slug": "vaqtara",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vaqtara",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060d",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05060d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaqtara.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.vaqtara.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05060d"
      },
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": false } }]
    ],
    "extra": {
      "brandEn": "VAQTARA",
      "apiBaseUrl": ""
    }
  }
}
